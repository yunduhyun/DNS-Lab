# 관리자 비밀번호는 직접 지정하며, 12자 이상을 사용한다.
ADMIN_USER=admin
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3000
# demo는 샘플 데이터이며 AWS에 접근하지 않는다. 실제 연결 시 aws로 변경한다.
DATA_MODE=demo
AWS_REGION=ap-northeast-2
# 로컬 AWS 연결 시에만 사용한다. EC2에서는 삭제하여 IAM 역할을 사용한다.
# AWS_PROFILE=dns-project
DYNAMODB_TABLE=dns-domain-analysis
S3_BUCKET=dns-analysis-reports-994899741506-ap-northeast-2-an
